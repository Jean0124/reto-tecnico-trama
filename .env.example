# Copiá este archivo como .env.local y completá los valores. Nunca commitees .env.local.

# Key de OpenAI (solo servidor). En Vercel: Settings → Environment Variables.
OPENAI_API_KEY=

# Modelo a usar (opcional).
OPENAI_MODEL=gpt-4.1-mini

# Endpoint compatible con OpenAI (opcional). Vacío = API oficial de OpenAI.
# Para probar con OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 y OPENAI_MODEL=openai/gpt-4.1-mini
OPENAI_BASE_URL=

# Contraseña de acceso a la app (recomendada en la URL pública). Vacía = sin contraseña.
ACCESS_PASSWORD=

# Tiempos máximos (opcional). Por defecto 20 s por llamada al modelo y 55 s por turno (Vercel corta a los 60 s).
# Para modelos lentos en local (ej. modelos :free de OpenRouter): LLM_TIMEOUT_MS=60000 y TURNO_TIMEOUT_MS=140000.
LLM_TIMEOUT_MS=
TURNO_TIMEOUT_MS=

# Límite de mensajes por IP y ventana (opcional).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=600000

# 1 = usa un modelo simulado (sin key, sin red) para probar la UI y el e2e.
LLM_SIMULADO=
